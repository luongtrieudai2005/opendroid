{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bug-bounty-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "mcp_server"],
      "enabled": true
    }
  },
  "compaction": {
    "auto": false,
    "tail_turns": 999
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow"
  }
}
